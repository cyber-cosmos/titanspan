
# Titanspan EditorConfig
# https://editorconfig.org

root = true

# Default settings for all files.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 80

# Python source files and type stubs.
[*.{py,pyi}]
indent_size = 4
max_line_length = 80

# JavaScript and TypeScript.
[*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}]
indent_size = 2

# Vue components.
[*.vue]
indent_size = 2

# Stylesheets.
[*.{css,scss,sass,less}]
indent_size = 2

# HTML and XML.
[*.{html,htm,xml,svg}]
indent_size = 2

# YAML configuration.
[*.{yml,yaml}]
indent_size = 2

# JSON configuration.
[*.{json,jsonc}]
indent_size = 2

# TOML configuration.
[*.toml]
indent_size = 4

# INI configuration.
[*.{ini,cfg,conf}]
indent_size = 4

# Shell scripts.
[*.{sh,bash,zsh}]
indent_size = 4

# Markdown documentation.
[*.{md,mdx,cff}]
indent_size = 2
trim_trailing_whitespace = false

# reStructuredText documentation.
[*.rst]
indent_size = 4

# Makefiles require literal tabs for recipes.
[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab
indent_size = 4
tab_width = 4

# Docker configuration.
[{Dockerfile,Dockerfile.*,*.dockerfile}]
indent_size = 4

# Environment configuration.
[{.env,.env.*,*.env}]
indent_size = 4

# Git configuration.
[{.gitconfig,.gitmodules}]
indent_style = tab
indent_size = 4

# Generated lockfiles must remain tool-managed.
[{uv.lock,package-lock.json,pnpm-lock.yaml,yarn.lock}]
indent_size = unset
indent_style = unset
max_line_length = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
